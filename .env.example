# LiveKit Cloud project settings. Never expose API_SECRET in browser code.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=replace_with_a_random_32_plus_character_secret
LIVEKIT_AGENT_NAME=market-research-agent

# Optional tuning for `python agent.py start` on small hosts.
# LIVEKIT_LOAD_THRESHOLD=1.0
# LIVEKIT_NUM_IDLE_PROCESSES=1

# LiveKit inference models. Change only after confirming availability in your project.
LIVEKIT_LLM_MODEL=openai/gpt-4.1-mini
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02

# Local data service. Generate a separate random 32-plus-character value.
RESEARCH_API_URL=http://127.0.0.1:8010
RESEARCH_DATA_SECRET=replace_with_a_different_random_32_plus_character_secret
RESEARCH_DATABASE_PATH=data/research.db
