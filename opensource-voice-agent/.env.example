# Server-side OpenAI-compatible API endpoint. Keep the /v1 suffix; do not use /chat/completions.
LLM_BASE_URL=https://llm.example.com/v1
# Server-side secret. Never expose this value to browser code.
LLM_API_KEY=
LLM_MODEL=
# SQLite file; parent directories are created by the app.
DATABASE_PATH=data/interviews.sqlite3
